# Data source: "fixture" (default, local JSON) or "sheets" (real registry, read-only).
JOB_SEARCH_DATA_SOURCE=fixture

# Only used when JOB_SEARCH_DATA_SOURCE=sheets.
JOB_SEARCH_SHEET_ID=
# Read-only service account (spreadsheets.readonly, Viewer on the Sheet). Never commit it.
# Deploy: base64 of the JSON key as a secret env var.
GOOGLE_SA_JSON_B64=
# Local dev alternative: path to the JSON key outside the repository.
GOOGLE_SA_JSON_PATH=

# Auth (Auth.js v5, Google). Every route requires a session whose email equals ALLOWED_EMAIL;
# unset/blank ALLOWED_EMAIL allows nobody. Generate AUTH_SECRET with `npx auth secret` or
# `openssl rand -base64 33`. Google OAuth client (Web application) redirect URI:
# <origin>/api/auth/callback/google.
ALLOWED_EMAIL=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only for `next start` outside Vercel. Leave commented: an empty value disables host trust.
# AUTH_TRUST_HOST=true
